+def manipulability_penalty(chain, q, characteristic_length=0.5, sigma_safe=SIGMA_MIN_SAFE):
+    """计算归一化几何雅可比的 Yoshikawa 可操作度 w(q) 与最小奇异值 σ_min(q) 软惩罚项。"""
+    try:
+        fk_res = chain.fk_all(q)
+        J = chain.jacobian(q, fk_res) if hasattr(chain, "jacobian") else None
+        if J is None:
+            return 0.0, np.nan, np.nan
+        J_s = np.asarray(J, dtype=float).copy()
+        J_s[:3, :] /= float(characteristic_length)
+        sv = np.linalg.svd(J_s, compute_uv=False)
+        sigma_min = float(sv[-1]) if sv.size else 0.0
+        yoshikawa = float(np.prod(sv)) if sv.size else 0.0
+        hinge = max(0.0, 1.0 - sigma_min / max(sigma_safe, 1e-6))
+        return float(hinge * hinge), yoshikawa, sigma_min
+    except Exception:
+        return 0.0, np.nan, np.nan
+
