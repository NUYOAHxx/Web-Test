# =============================================================================
def collect_pinocchio_candidates_and_seeds(
    pin_model,
    pin_data,
    pin_maps,
    ee_frame_id,
    chain,
    T_target_pin,
    T_target_local,
    psi_ready,
    q_prev,
    q_ready,
    lower,
    upper,
    rng,
    orientation_mode="full",
    tool_axis=None,
    tool_cone_half_angle=None,
    include_waist=False,
    dls_params=None,
):
    """
   Run Pinocchio damped-LS IK from many seeds.

    Parameters
    ----------
    T_target_pin : np.ndarray
        4x4 target pose in Pinocchio model root frame (for IK).
    T_target_local : np.ndarray
        4x4 target pose in arm base/local frame (for scoring via SerialChain).
    include_waist : bool
        9-DOF waist+arm mode: first try with the waist fixed at q_ready, then
        fall back to waist+arm seeds and prefer a low-waist valid solution.
    dls_params : dict, optional
        {"max_iter", "damping", "max_step"} overrides for the per-seed DLS.

    Returns
    -------
   (candidates, seeds_for_direct, per_seed)
        per_seed entries mirror pink_ik_one_seed's seed_diag plus
        {"seed_idx", "pose_ok", "margin"}.
    """
    scatter_seeds = make_scatter_seeds(
        q_prev=q_prev,
        q_ready=q_ready,
        lower=lower,
        upper=upper,
        rng=rng,
    )
    fixed_joint_masks = [None] * len(scatter_seeds)
    if include_waist:
        fixed_waist_mask = np.array(
          [name in WAIST_JOINT_NAMES for name in pin_maps["active_names"]],
            dtype=bool,
        )
       scatter_seeds.insert(0, q_ready.copy())
        fixed_joint_masks.insert(0, fixed_waist_mask)

    pin_candidates = []
   per_seed = []
    unique_qs = []
    arm_first_failed = False
    valid_safe_count = 0
  if include_waist:
        joint_weights = np.array(
            [
                WAIST_TASK_WEIGHT if n in WAIST_JOINT_NAMES else 1.0
                for n in pin_maps["active_names"]
            ],
            dtype=float,
        )
        null_ref = q_ready
    else:
        joint_weights = None
        null_ref = None
    for seed_idx, seed in enumerate(scatter_seeds):
        try:
            q, seed_diag = pinocchio_ik_one_seed(
                pin_model=pin_model,
                pin_data=pin_data,
             pin_maps=pin_maps,
                ee_frame_id=ee_frame_id,
                T_target=T_target_pin,
                seed=seed,
                lower=lower,
                upper=upper,
                orientation_mode=orientation_mode,
                tool_axis=tool_axis,
                tool_cone_half_angle=tool_cone_half_angle,
                joint_weights=joint_weights,
                q_ref=null_ref,
                include_waist=include_waist,
                fixed_joint_mask=fixed_joint_masks[seed_idx],
                waist_release=include_waist,
                **(dls_params or {}),
            )
        except Exception as exc:
            if include_waist and seed_idx == 0:
                arm_first_failed = True
            per_seed.append(
                {
                    "seed_idx": seed_idx,
                    "converged": False,
                    "iters": 0,
                    "exception": repr(exc),
                }
            )
            continue
        duplicate = False
        for old in unique_qs:
            if np.linalg.norm(q - old) < 1e-5:
                duplicate = True
                break

        if duplicate:
            continue
      unique_qs.append(q.copy())

        # Score using SerialChain FK (always in local/base frame)
        info = score_candidate(
            chain,
            q,
            T_target_local,
            psi_ready,
            q_prev,
            q_ready,
            lower,
            upper,
            orientation_mode=orientation_mode,
            tool_axis=tool_axis,
           tool_cone_half_angle=tool_cone_half_angle,
            apply_waist_return=include_waist,
        )

        if include_waist and seed_idx == 0 and not info["pose_ok"]:
            arm_first_failed = True
        info["source"] = "pinocchio_ik"
        info["solve_method"] = "pinocchio_damped_ls_ik"
        info["fallback_used"] = True
        info["seed_used"] = seed_idx
        info["converged"] = bool(seed_diag["converged"])

        pin_candidates.append(info)
        per_seed.append(
            {
                "seed_idx": seed_idx,
                **seed_diag,
                "pose_ok": bool(info["pose_ok"]),
                "margin": float(info["margin"]),
            }
        )

####################有解早停
        if info["pose_ok"] and info["margin"] >= SAFE_MARGIN:
            valid_safe_count += 1
            need_fast_fallback = arm_first_failed and seed_idx > 0
            waist_is_neutral = (
               not include_waist
                or info["waist_dev"] <= WAIST_RETURN_TOL
            )

            if waist_is_neutral or need_fast_fallback:
                return pin_candidates, [info["q"]], per_seed

            if valid_safe_count >= PIN_IK_MAX_VALID_CANDIDATES:
                sorted_valid = sorted(
                    pin_candidates,
                    key=candidate_sort_key,
                )
                return (
                    pin_candidates,
                    [candidate["q"] for candidate in sorted_valid[:PIN_TOP_K_FOR_DIRECT]],
                    per_seed,
                )
################
    sorted_pin = sorted(pin_candidates, key=candidate_sort_key)

    pin_seeds_for_direct = [c["q"] for c in sorted_pin[:PIN_TOP_K_FOR_DIRECT]]
    return pin_candidates, pin_seeds_for_direct, per_seed


