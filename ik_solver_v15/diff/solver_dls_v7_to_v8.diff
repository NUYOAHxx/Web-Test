+                entry.update(kind="gravity_check_failed", lower=-np.inf, upper=np.inf)
+                info[name] = entry
+                continue
+            raw = allowable.get(name, spec.get("raw_effort", np.nan))
+            a_cap = float(raw) if raw is not None and np.isfinite(raw) and raw > 0.0 else np.inf
