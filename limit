序号,关节名称,关节类型/功能,旋转轴,关节限位范围,代码中的角色与映射
1,Hip_Link1,腰部俯仰 (Pitch),Y 轴,±120∘,复合构型中的腰部基底自由度
2,Body_Link,腰部旋转 (Yaw),Z 轴,±360∘ (连续/大范围),躯干偏航转体（代码中专门针对其做了偏航释放逻辑）
3,LHand_Link1,肩部安装/基底,Z 轴,±360∘,7-DOF 手臂链的起点
4,LHand_Link2,肩部俯仰 (S),Z 轴* (或对应构型轴),−90∘∼+45∘,负责手臂上下俯仰，代码中通过 _Link2 寻找肩部关节坐标原点以计算最大臂展
5,LHand_Link3,大臂自转,Z 轴,±360∘,手臂冗余自由度调节
6,LHand_Link4,肘关节 (E),旋转轴,−120∘∼+40∘,屈伸关键关节
7,LHand_Link5,小臂自转,Z 轴,±360∘,手臂冗余自由度调节
8,LHand_Link6,腕部俯仰 (W),Z 轴,+60∘∼+120∘,末端姿态调整（注意此处的非对称正限位）
9,LHand_Link7,腕部自转,Z 轴,±30∘,末端滚转微调（活动范围较小）
#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""Pinocchio 阻尼最小二乘 IK 核心（含防漂移锚定、重力矩卸载与重心稳定）。

本模块只包含单 seed 数值算法和 Pinocchio 模型映射。候选打分与
portfolio 编排保留在 ``ha_arm_ik.solver``。
"""

import math

import numpy as np
from scipy.linalg import cho_factor, cho_solve

try:
    import pinocchio as pin
except Exception:
    pin = None

from ha_arm_ik.ik_common import (
    TOOL_AXIS_X,
    clip_to_bounds,
    closest_direction_on_cone,
    normalize,
    normalize_cone_half_angle,
    skew,
    unique_seed_list,
    validate_orientation_mode,
)
from ha_arm_ik.robot_model import WAIST_JOINT_NAMES

# =============================================================================
# 1. 基础数值与收敛容差参数
# =============================================================================
PIN_IK_MAX_ITER = 500
PIN_IK_DAMPING = 1e-6
PIN_IK_POS_TOL = 5e-4
PIN_IK_ORI_TOL = 5e-4
PIN_IK_MAX_STEP = 0.5             # 单次迭代关节步长上限（弧度）

# =============================================================================
# 2. 停滞检测与随机种子参数
# =============================================================================
PIN_IK_STALL_ITERS = 25           # 连续微进展迭代次数上限 -> 放弃
PIN_IK_STALL_DELTA_M = 5e-5       # 单次迭代进展阈值（米，= 0.05 mm）
PIN_IK_MAX_VALID_CANDIDATES = 2
WAIST_RETURN_TOL = 0.10           # 腰部已接近中位时的早停阈值
N_NOISE_PER_BASE = 16
NOISE_SCALES = [0.02, 0.05, 0.10, 0.20]

# =============================================================================
# 3. 零空间防漂移与收敛后流形精修参数（解决来回解算不一致）
# =============================================================================
NULLSPACE_GAIN = 0.20             # 手臂冗余关节拉向 q_ref 的次任务增益
WAIST_NULL_GAIN = 0.40            # 腰部关节拉向 q_ref（直立位）的次任务增益
NULLSPACE_ERR_SCALE = 0.05        # 主任务误差小于此值(m/rad)时零空间整理全功率激活
WAIST_POST_GAIN = 0.30            # 收敛后在等位姿流形上精修冗余姿态的步长增益
WAIST_POST_ITERS = 50             # 收敛后流形精修最大迭代次数
WAIST_POST_STEP = 0.05            # 精修单次迭代姿态步长的最大 2-范数（弧度）
WAIST_POST_TOL = 0.005            # 精修停止的关节距离阈值（弧度）

# =============================================================================
# 4. 腰部自适应释放参数（兼顾躯干稳定与远伸可达性）
# =============================================================================
WAIST_TASK_WEIGHT = 5.0           # 近距离时腰部关节空间代价（手臂 = 1.0，锁死稳重心）
WAIST_TASK_WEIGHT_FAR = 1.0       # 远目标完全释放后的腰部权重（与手臂平权协同，防过度弯腰）
WAIST_RELEASE_START = 0.75        # 肩->目标距离/最大臂展 达到此比例开始放腰
WAIST_RELEASE_END = 0.94          # 达到此比例腰完全释放
WAIST_RETURN_RELEASE_RAD = 0.25   # 返程解锁裕度(rad)：腰偏离 q_ref 超此值时保持释放通道以便回正
WAIST_STAG_STEP = 0.15            # 停滞解锁：每步增加的腰部释放量
WAIST_STAG_DECAY = 0.20           # 有进展时释放量的衰减
WAIST_STAG_ERR_POS = 5e-3         # 判定"误差大"的位置阈值（米）
WAIST_STAG_ERR_ORI = 2e-2         # 判定"误差大"的姿态阈值（弧度）
WAIST_STAG_DECREASE = 0.02        # 单步误差平方下降 <2% 视为停滞
WAIST_STAG_MIN_STALL = 5          # 主停滞计数达此值后停滞解锁才允许激活

# =============================================================================
# 5. 电机负载卸载、重心稳定与非对称限位保护参数
# =============================================================================
GRAVITY_TORQUE_GAIN = 0.05        # 零空间抗重力矩增益（减小腰/肩电机静态负载）
COM_XY_GAIN = 0.10                # 零空间整机重心(CoM)水平防倾倒增益
JOINT_LIMIT_GAIN = 0.02           # 非对称限位居中排斥增益（防 Link2/Link6 等贴边卡死）


# =============================================================================
# 配置与 Pinocchio 映射
# =============================================================================
def build_pinocchio_joint_maps(model, active_joint_names):
    """建立 active_joint_names 与 Pinocchio 关节索引之间的映射。

    Pinocchio model.joints[0] 是"universe"（固定根关节）。
    实际关节从索引 1 开始。

    返回
    -------
    maps : dict
        - "name_to_joint_id"  : {关节名: pinocchio joint id}
        - "name_to_q_idx"     : {关节名: model q 向量中的索引}
        - "name_to_v_idx"     : {关节名: model v 向量中的索引}
        - "active_q_indices"  : list[int]  活跃关节的 q 向量索引
        - "active_v_indices"  : list[int]  活跃关节的 v 向量索引
        - "effort_limits"     : np.ndarray 活跃关节的力矩限制
    """
    name_to_joint_id = {}
    name_to_q_idx = {}
    name_to_v_idx = {}

    for jid in range(1, model.njoints):
        name = model.names[jid]
        name_to_joint_id[name] = jid
        name_to_q_idx[name] = model.joints[jid].idx_q
        name_to_v_idx[name] = model.joints[jid].idx_v

    active_q_indices = []
    active_v_indices = []
    active_names = []
    effort_limits = []

    for name in active_joint_names:
        if name not in name_to_joint_id:
            raise KeyError(
                f"Active joint '{name}' not found in Pinocchio model. "
                f"Available: {list(name_to_joint_id.keys())}"
            )
        active_q_indices.append(name_to_q_idx[name])
        active_v_indices.append(name_to_v_idx[name])
        active_names.append(name)

        jid = name_to_joint_id[name]
        eff = float(model.effortLimit[model.joints[jid].idx_v])
        effort_limits.append(eff if eff > 1e-9 else 1.0)

    return {
        "name_to_joint_id": name_to_joint_id,
        "name_to_q_idx": name_to_q_idx,
        "name_to_v_idx": name_to_v_idx,
        "active_q_indices": active_q_indices,
        "active_v_indices": active_v_indices,
        "active_names": active_names,
        "effort_limits": np.array(effort_limits, dtype=float),
    }


def active_q_to_pinocchio_q(model, pin_maps, q_active):
    """由我们的活跃关节值构造完整的 Pinocchio q 向量。

    非活跃关节置为 neutral（零位）构型。
    """
    q_full = pin.neutral(model)
    for k, q_idx in enumerate(pin_maps["active_q_indices"]):
        q_full[q_idx] = float(q_active[k])

    return q_full


def pinocchio_q_to_active_q(pin_maps, q_full):
    """从完整 Pinocchio q 向量中提取活跃关节值。"""
    return np.array(
        [float(q_full[idx]) for idx in pin_maps["active_q_indices"]],
        dtype=float,
    )


def estimate_arm_max_reach(pin_model, pin_maps, ee_frame_id):
    """从 Pinocchio 模型解析肩->TCP 的最大距离：

        ‖Link3 origin‖ + ‖Link5 origin‖ + ‖EE frame placement‖

    对应 wdls_9r_pro 的 r_stw_max（0.2378 + 0.1719）加 TCP 偏移。
    关节名按 LHand/RHand_Link{3,5} 约定查找；查不到时返回 None。
    """
    arm_names = [
        n for n in pin_maps["active_names"] if n not in WAIST_JOINT_NAMES
    ]
    if not arm_names:
        return None

    side_prefix = (
        "LHand" if any(n.startswith("LHand") for n in arm_names) else "RHand"
    )
    reach = 0.0
    for link_idx in (3, 5):
        name = f"{side_prefix}_Link{link_idx}"
        if name not in pin_maps["name_to_joint_id"]:
            return None
        jid = pin_maps["name_to_joint_id"][name]
        seg = float(np.linalg.norm(pin_model.jointPlacements[jid].translation))
        if seg <= 1e-9:
            return None
        reach += seg

    # TCP 偏移取自 EE frame 相对其父关节的 placement
    frame = pin_model.frames[ee_frame_id]
    tcp_off = float(np.linalg.norm(frame.placement.translation))
    return reach + tcp_off


def _compute_nullspace_gradient(
    pin_model,
    pin_data,
    q_full,
    q_active_cur,
    q_ref,
    lower,
    upper,
    ns_gain,
    active_v_indices,
    effort_limits,
    movable_mask,
    include_waist,
):
    """合成零空间次任务负梯度：姿态防漂移锚定 + 非对称限位居中 + 重力矩卸载 + 重心稳定。"""
    # 1. 姿态锚定梯度：拉向固定的全局参考姿态 q_ref (如 q_ready)，消除多圈与往返漂移
    z_total = ns_gain * (q_ref - q_active_cur)

    # 2. 非对称限位居中排斥梯度：防止 Link2(-90~45°)、Link6(60~120°) 等卡死在物理边界
    if JOINT_LIMIT_GAIN > 0.0:
        q_mid = 0.5 * (lower + upper)
        q_span = np.maximum(upper - lower, 1e-3)
        z_limit = JOINT_LIMIT_GAIN * ((q_mid - q_active_cur) / (q_span ** 2))
        z_total += z_limit

    # 3. 电机重力矩卸载梯度：最小化 H_grav = 0.5 * || tau_g / effort_limit ||^2
    if GRAVITY_TORQUE_GAIN > 0.0:
        try:
            dtau_dq_full = pin.computeGeneralizedGravityDerivatives(
                pin_model, pin_data, q_full
            )
            tau_g_active = pin_data.g[active_v_indices]
            dtau_dq_active = dtau_dq_full[
                np.ix_(active_v_indices, active_v_indices)
            ]
            normalized_tau = tau_g_active / (effort_limits ** 2)
            z_gravity = -GRAVITY_TORQUE_GAIN * (
                dtau_dq_active.T @ normalized_tau
            )
            z_total += z_gravity
        except Exception:
            pass

    # 4. 整机重心 (CoM) 水平防倾倒梯度：包含腰部时，将质心 X/Y 投影拉回基座原点
    if include_waist and COM_XY_GAIN > 0.0:
        try:
            J_com_full = pin.jacobianCenterOfMass(
                pin_model, pin_data, q_full, False
            )
            com_xy = pin_data.com[0][:2]
            J_com_xy = J_com_full[:2, active_v_indices]
            z_com = -COM_XY_GAIN * (J_com_xy.T @ com_xy)
            z_total += z_com
        except Exception:
            pass

    return z_total * movable_mask


def pinocchio_ik_one_seed(
    pin_model,
    pin_data,
    pin_maps,
    ee_frame_id,
    T_target,
    seed,
    lower,
    upper,
    max_iter=PIN_IK_MAX_ITER,
    damping=PIN_IK_DAMPING,
    pos_tol=PIN_IK_POS_TOL,
    ori_tol=PIN_IK_ORI_TOL,
    max_step=PIN_IK_MAX_STEP,
    orientation_mode="full",
    tool_axis=None,
    tool_cone_half_angle=None,
    joint_weights=None,
    q_ref=None,
    include_waist=False,
    fixed_joint_mask=None,
    waist_release=False,
    waist_max_reach=None,
):
    """使用 Pinocchio FK + Jacobian 的阻尼最小二乘 IK。

    返回 (q_active, seed_diag)，其中 seed_diag 与
    pink_ik_one_seed 的结构一致：
    {"converged", "iters", "final_pos_err", "final_ori_err", "stalled"}。

    重要提示：
        为保证往返解算的闭环一致性，外层调用时请确保传入固定的 ``q_ref``（如 ``q_ready``），
        不要将动态变化的 ``q_prev`` 作为 ``q_ref``。
    """
    orientation_mode = validate_orientation_mode(orientation_mode)
    tool_cone_half_angle = normalize_cone_half_angle(tool_cone_half_angle)
    if tool_axis is None:
        tool_axis = TOOL_AXIS_X

    tool_axis = normalize(tool_axis)
    seed = np.asarray(seed, dtype=float)
    q_full = active_q_to_pinocchio_q(pin_model, pin_maps, seed)

    if q_ref is None:
        q_ref = seed.copy()
    else:
        q_ref = np.asarray(q_ref, dtype=float).copy()

    if joint_weights is None:
        joint_weights = np.ones(len(pin_maps["active_v_indices"]), dtype=float)
    else:
        joint_weights = np.asarray(joint_weights, dtype=float)

    R_des = np.asarray(T_target[:3, :3], dtype=float, order="C")
    p_des = np.asarray(T_target[:3, 3], dtype=float)

    oMdes = pin.SE3(R_des, p_des)
    d_des = normalize(R_des @ tool_axis)

    active_q_indices = np.asarray(pin_maps["active_q_indices"], dtype=np.intp)
    active_v_indices = np.asarray(pin_maps["active_v_indices"], dtype=np.intp)
    effort_limits = pin_maps["effort_limits"]
    n_active = len(active_v_indices)

    # 关节侧加权：最小二乘度量中的 W^-1。更大的腰部权重
    # 使腰部运动比手臂运动更"昂贵"。
    W_inv = np.diag(1.0 / joint_weights)

    ns_gain = np.full(n_active, NULLSPACE_GAIN, dtype=float)
    for k, name in enumerate(pin_maps["active_names"]):
        if name in WAIST_JOINT_NAMES:
            ns_gain[k] = WAIST_NULL_GAIN
    use_nullspace = bool(
        np.any(ns_gain > 0.0)
        or GRAVITY_TORQUE_GAIN > 0.0
        or JOINT_LIMIT_GAIN > 0.0
        or (include_waist and COM_XY_GAIN > 0.0)
    )

    seed_diag = {
        "converged": False,
        "iters": 0,
        "final_pos_err": float("nan"),
        "final_ori_err": float("nan"),
        "stalled": False,
        "error_history": [],
    }
    posture_neutral_refine = bool(WAIST_POST_GAIN > 0.0)
    fixed_joint_mask = (
        np.asarray(fixed_joint_mask, dtype=bool)
        if fixed_joint_mask is not None
        else np.zeros(n_active, dtype=bool)
    )
    movable_mask = ~fixed_joint_mask
    W_inv_movable = W_inv[np.ix_(movable_mask, movable_mask)].copy()
    waist_mask = np.array(
        [
            1.0 if name in WAIST_JOINT_NAMES else 0.0
            for name in pin_maps["active_names"]
        ],
        dtype=float,
    )
    waist_bool_mask = waist_mask.astype(bool)

    # 腰部自适应释放的初始化：找出可动的腰部关节在 movable 子空间中的
    # 位置，并解析肩关节 id 与最大臂展。任何前提不满足则整体旁路。
    waist_release_active = bool(
        waist_release
        and include_waist
        and np.any(waist_bool_mask & movable_mask)
    )
    if waist_release_active and waist_max_reach is None:
        waist_max_reach = estimate_arm_max_reach(
            pin_model,
            pin_maps,
            ee_frame_id,
        )
    waist_release_active = bool(waist_release_active and waist_max_reach)

    shoulder_jid = None
    if waist_release_active:
        shoulder_name = None
        for name in pin_maps["active_names"]:
            if name not in WAIST_JOINT_NAMES and name.endswith("_Link2"):
                shoulder_name = name
                break
        if shoulder_name is None:
            waist_release_active = False
        else:
            shoulder_jid = pin_maps["name_to_joint_id"][shoulder_name]

    # 注意：W_inv_movable 的维度是 n_movable x n_movable，
    # 因此必须使用在 movable 子空间内的相对索引来更新对角元！
    waist_in_movable_indices = np.nonzero(waist_bool_mask[movable_mask])[0]

    # movable 子空间中腰部对角元的 W_inv 基线值与完全释放值
    waist_w_inv_stiff = (
        1.0 / WAIST_TASK_WEIGHT if WAIST_TASK_WEIGHT > 0 else 1.0
    )
    waist_w_inv_far = (
        1.0 / WAIST_TASK_WEIGHT_FAR if WAIST_TASK_WEIGHT_FAR > 0 else 1e3
    )
    stagnation = 0.0
    prev_err_sq = float("inf")

    def _posture_neutral_refine(q_start_full):
        """在等位姿流形上把已收敛的解继续向零空间最优姿态（回中+低力矩+稳重心）精修。"""
        q_work = q_start_full.copy()
        best_q_full = q_start_full.copy()
        best_posture_cost = float("inf")
        no_improvement = 0

        # 精修阶段允许所有可动关节（腰+臂）协同整理姿态
        W_inv_refine = W_inv.copy()
        if include_waist:
            # 精修时放开腰部阻尼，让歪掉的腰能顺畅退回 q_ref
            for k in range(n_active):
                if waist_bool_mask[k] and movable_mask[k]:
                    W_inv_refine[k, k] = max(
                        W_inv_refine[k, k], waist_w_inv_far
                    )
        W_inv_ref_mov = W_inv_refine[np.ix_(movable_mask, movable_mask)]

        for _ in range(WAIST_POST_ITERS):
            pin.forwardKinematics(pin_model, pin_data, q_work)
            pin.updateFramePlacements(pin_model, pin_data)
            oMref = pin_data.oMf[ee_frame_id]

            if orientation_mode == "full":
                refine_err_se3 = pin.log6(oMref.inverse() * oMdes)
                refine_pos_err = np.linalg.norm(refine_err_se3.linear)
                refine_ori_err = np.linalg.norm(refine_err_se3.angular)
                if refine_pos_err >= pos_tol or refine_ori_err >= ori_tol:
                    break
                refine_J_full = pin.computeFrameJacobian(
                    pin_model,
                    pin_data,
                    q_work,
                    ee_frame_id,
                    pin.LOCAL,
                )
                refine_J = refine_J_full[:, active_v_indices]
            elif orientation_mode == "tool_dir":
                R_ref = np.asarray(oMref.rotation, dtype=float)
                p_ref = np.asarray(oMref.translation, dtype=float)
                d_ref = normalize(R_ref @ tool_axis)
                refine_pos_err = np.linalg.norm(p_des - p_ref)
                refine_dir_err = np.arccos(
                    np.clip(float(np.dot(d_ref, d_des)), -1.0, 1.0)
                )
                if refine_pos_err >= pos_tol or refine_dir_err >= ori_tol:
                    break
                refine_J_full = pin.computeFrameJacobian(
                    pin_model,
                    pin_data,
                    q_work,
                    ee_frame_id,
                    pin.WORLD,
                )[:, active_v_indices]
                refine_J = np.vstack(
                    [
                        refine_J_full[:3, :],
                        -skew(d_ref) @ refine_J_full[3:, :],
                    ]
                )
            else:
                R_ref = np.asarray(oMref.rotation, dtype=float)
                p_ref = np.asarray(oMref.translation, dtype=float)
                d_ref = normalize(R_ref @ tool_axis)
                refine_pos_err = np.linalg.norm(p_des - p_ref)
                _, _, refine_dir_err, inside = closest_direction_on_cone(
                    d_current=d_ref,
                    d_target=d_des,
                    cone_half_angle=tool_cone_half_angle,
                )
                if refine_pos_err >= pos_tol or (
                    not inside and refine_dir_err >= ori_tol
                ):
                    break
                refine_J_full = pin.computeFrameJacobian(
                    pin_model,
                    pin_data,
                    q_work,
                    ee_frame_id,
                    pin.WORLD,
                )[:, active_v_indices]
                if inside:
                    refine_J = np.vstack(
                        [
                            refine_J_full[:3, :],
                            np.zeros_like(refine_J_full[3:, :]),
                        ]
                    )
                else:
                    refine_J = np.vstack(
                        [
                            refine_J_full[:3, :],
                            -skew(d_ref) @ refine_J_full[3:, :],
                        ]
                    )

            q_work_active = q_work[active_q_indices]
            # 评估加权姿态偏离代价
            weighted_diff = ns_gain * (q_ref - q_work_active) * movable_mask
            posture_cost = float(np.linalg.norm(weighted_diff))

            if posture_cost < best_posture_cost - 1e-6:
                best_posture_cost = posture_cost
                best_q_full = q_work.copy()
                no_improvement = 0
            else:
                no_improvement += 1
                if no_improvement >= 5:
                    break

            if posture_cost < WAIST_POST_TOL:
                break

            z_refine = _compute_nullspace_gradient(
                pin_model,
                pin_data,
                q_work,
                q_work_active,
                q_ref,
                lower,
                upper,
                ns_gain,
                active_v_indices,
                effort_limits,
                movable_mask,
                include_waist,
            )

            J_ref_mov = refine_J[:, movable_mask]
            task_dim = J_ref_mov.shape[0]
            A_ref = J_ref_mov @ W_inv_ref_mov @ J_ref_mov.T
            A_ref.flat[:: task_dim + 1] += damping

            try:
                J_ref_invA = cho_solve(
                    cho_factor(A_ref, check_finite=False),
                    J_ref_mov,
                    check_finite=False,
                )
            except (np.linalg.LinAlgError, ValueError):
                J_ref_invA = np.linalg.solve(A_ref, J_ref_mov)

            z_mov = z_refine[movable_mask]
            Jz_ref = J_ref_mov @ z_mov
            dq_mov = WAIST_POST_GAIN * (
                z_mov - W_inv_ref_mov @ (J_ref_invA.T @ Jz_ref)
            )

            dq_norm = float(np.linalg.norm(dq_mov))
            if dq_norm > WAIST_POST_STEP:
                dq_mov *= WAIST_POST_STEP / dq_norm
            if dq_norm < 1e-6:
                break

            q_next_active = q_work_active.copy()
            q_next_active[movable_mask] += dq_mov
            np.clip(
                q_next_active,
                lower + 1e-9,
                upper - 1e-9,
                out=q_next_active,
            )
            q_work[active_q_indices] = q_next_active

        return best_q_full

    prev_pos_err = None
    stall_count = 0
    dq_active = np.zeros(n_active, dtype=float)

    for it in range(max_iter):
        pin.forwardKinematics(pin_model, pin_data, q_full)
        pin.updateFramePlacements(pin_model, pin_data)

        oMcur = pin_data.oMf[ee_frame_id]
        if orientation_mode == "full":
            err_se3 = pin.log6(oMcur.inverse() * oMdes)

            seed_diag["iters"] = it + 1
            pos_norm = math.sqrt(float(err_se3.linear @ err_se3.linear))
            ori_norm = math.sqrt(float(err_se3.angular @ err_se3.angular))
            seed_diag["final_pos_err"] = pos_norm
            seed_diag["final_ori_err"] = ori_norm
            seed_diag["error_history"].append(
                {"iteration": it + 1, "pos_err": pos_norm, "ori_err": ori_norm}
            )

            if pos_norm < pos_tol and ori_norm < ori_tol:
                seed_diag["converged"] = True
                if posture_neutral_refine:
                    q_full = _posture_neutral_refine(q_full)
                break

            err = err_se3.vector
            J_full = pin.computeFrameJacobian(
                pin_model,
                pin_data,
                q_full,
                ee_frame_id,
                pin.LOCAL,
            )
            J_active = J_full[:, active_v_indices]

        elif orientation_mode == "tool_dir":
            R_cur = np.asarray(oMcur.rotation, dtype=float)
            p_cur = np.asarray(oMcur.translation, dtype=float)
            d_cur = normalize(R_cur @ tool_axis)

            e_pos = p_des - p_cur
            e_dir = d_des - d_cur

            dir_angle = float(
                np.arccos(np.clip(float(np.dot(d_cur, d_des)), -1.0, 1.0))
            )

            seed_diag["iters"] = it + 1
            seed_diag["final_pos_err"] = float(np.linalg.norm(e_pos))
            seed_diag["final_ori_err"] = dir_angle
            seed_diag["error_history"].append(
                {
                    "iteration": it + 1,
                    "pos_err": seed_diag["final_pos_err"],
                    "ori_err": dir_angle,
                }
            )

            if np.linalg.norm(e_pos) < pos_tol and dir_angle < ori_tol:
                seed_diag["converged"] = True
                if posture_neutral_refine:
                    q_full = _posture_neutral_refine(q_full)
                break

            J_full = pin.computeFrameJacobian(
                pin_model,
                pin_data,
                q_full,
                ee_frame_id,
                pin.WORLD,
            )
            J_active_full = J_full[:, active_v_indices]

            Jv = J_active_full[:3, :]
            Jw = J_active_full[3:, :]
            J_dir = -skew(d_cur) @ Jw

            err = np.concatenate([e_pos, e_dir])
            J_active = np.vstack([Jv, J_dir])

        elif orientation_mode == "tool_cone":
            R_cur = np.asarray(oMcur.rotation, dtype=float)
            p_cur = np.asarray(oMcur.translation, dtype=float)
            d_cur = normalize(R_cur @ tool_axis)

            e_pos = p_des - p_cur
            d_closest, dir_angle, cone_violation, inside = (
                closest_direction_on_cone(
                    d_current=d_cur,
                    d_target=d_des,
                    cone_half_angle=tool_cone_half_angle,
                )
            )

            seed_diag["iters"] = it + 1
            seed_diag["final_pos_err"] = float(np.linalg.norm(e_pos))
            seed_diag["final_ori_err"] = dir_angle
            seed_diag["error_history"].append(
                {
                    "iteration": it + 1,
                    "pos_err": seed_diag["final_pos_err"],
                    "ori_err": dir_angle,
                }
            )

            if np.linalg.norm(e_pos) < pos_tol and cone_violation < ori_tol:
                seed_diag["converged"] = True
                if posture_neutral_refine:
                    q_full = _posture_neutral_refine(q_full)
                break

            J_full = pin.computeFrameJacobian(
                pin_model,
                pin_data,
                q_full,
                ee_frame_id,
                pin.WORLD,
            )
            J_active_full = J_full[:, active_v_indices]

            Jv = J_active_full[:3, :]
            Jw = J_active_full[3:, :]

            if inside or cone_violation <= ori_tol:
                e_dir = np.zeros(3, dtype=float)
                J_dir = np.zeros_like(Jw)
            else:
                e_dir = d_closest - d_cur
                J_dir = -skew(d_cur) @ Jw

            err = np.concatenate([e_pos, e_dir])
            J_active = np.vstack([Jv, J_dir])

        q_active_cur = q_full[active_q_indices]

        # 腰部自适应释放：
        # 1) 距离释放：肩->目标距离占最大臂展的比例经 smoothstep 释放；
        # 2) 返程回中释放：若当前腰部已偏离 q_ref（如刚从远伸状态返回近处目标），
        #    保持释放通道，防止"去程放腰、返程锁腰"造成不可逆的关节漂移；
        # 3) 停滞解锁：误差大但每步误差平方下降 <2% 时逐步解除腰部锁定。
        if waist_release_active:
            err_sq = float(err @ err)
            err_big = (
                seed_diag["final_pos_err"] > WAIST_STAG_ERR_POS
                or seed_diag["final_ori_err"] > WAIST_STAG_ERR_ORI
            )
            if err_big and err_sq > (1.0 - WAIST_STAG_DECREASE) * prev_err_sq:
                if stall_count >= WAIST_STAG_MIN_STALL:
                    stagnation = min(stagnation + WAIST_STAG_STEP, 1.0)
            else:
                stagnation = max(stagnation - WAIST_STAG_DECAY, 0.0)
            prev_err_sq = err_sq

            # 1) 按肩->目标距离计算释放量
            p_shoulder = pin_data.oMi[shoulder_jid].translation
            vec_to_target = p_des - p_shoulder
            dist = float(np.linalg.norm(vec_to_target))
            r_start = WAIST_RELEASE_START * waist_max_reach
            r_span = (WAIST_RELEASE_END - WAIST_RELEASE_START) * waist_max_reach
            t = np.clip((dist - r_start) / max(r_span, 1e-4), 0.0, 1.0)
            alpha_dist = float(t * t * (3.0 - 2.0 * t))

            # 2) 按当前腰部偏离量计算返程释放量
            waist_dev = float(
                np.linalg.norm(
                    (q_active_cur - q_ref)[waist_bool_mask & movable_mask]
                )
            )
            alpha_return = float(
                np.clip(
                    waist_dev / max(WAIST_RETURN_RELEASE_RAD, 1e-4), 0.0, 1.0
                )
            )

            alpha = max(alpha_dist, alpha_return, stagnation)

            # 更新 movable 子空间中腰部对角元
            w_inv_waist = (
                1.0 - alpha
            ) * waist_w_inv_stiff + alpha * waist_w_inv_far
            W_inv_movable[
                waist_in_movable_indices, waist_in_movable_indices
            ] = w_inv_waist

        # 关节侧加权阻尼最小二乘：
        #   J+_W = W^-1 J^T (J W^-1 J^T + λI)^-1
        J_solve = J_active[:, movable_mask]
        A = J_solve @ W_inv_movable @ J_solve.T
        A.flat[:: err.size + 1] += damping

        dq_active.fill(0.0)
        chol_fac = None
        try:
            chol_fac = cho_factor(A, check_finite=False)
            rhs = cho_solve(chol_fac, err, check_finite=False)
        except (np.linalg.LinAlgError, ValueError):
            rhs = np.linalg.solve(A, err)
        dq_active[movable_mask] = W_inv_movable @ (J_solve.T @ rhs)

        # 零空间次任务：把冗余自由度拉向唯一的最优稳态（回中 + 卸载重力矩 + 稳重心 + 远离限位）
        if use_nullspace:
            z_total = _compute_nullspace_gradient(
                pin_model,
                pin_data,
                q_full,
                q_active_cur,
                q_ref,
                lower,
                upper,
                ns_gain,
                active_v_indices,
                effort_limits,
                movable_mask,
                include_waist,
            )

            if chol_fac is not None:
                J_solve_invA = cho_solve(
                    chol_fac, J_solve, check_finite=False
                )
            else:
                J_solve_invA = np.linalg.solve(A, J_solve)

            z_mov = z_total[movable_mask]
            Jz = J_solve @ z_mov
            dq_null_movable = z_mov - W_inv_movable @ (J_solve_invA.T @ Jz)

            # 主任务误差越小（越接近收敛），零空间姿态整理权重越大！
            err_norm = float(np.linalg.norm(err))
            null_weight = 1.0 / (
                1.0 + (err_norm / max(NULLSPACE_ERR_SCALE, 1e-6)) ** 2
            )
            dq_active[movable_mask] += null_weight * dq_null_movable

        dq_norm = math.sqrt(float(dq_active @ dq_active))
        if dq_norm > max_step:
            dq_active *= max_step / dq_norm

        q_active_next = q_active_cur + dq_active
        np.clip(
            q_active_next,
            lower + 1e-9,
            upper - 1e-9,
            out=q_active_next,
        )
        q_full[active_q_indices] = q_active_next

        # 停滞检查
        if prev_pos_err is not None and (
            abs(prev_pos_err - seed_diag["final_pos_err"])
            < PIN_IK_STALL_DELTA_M
        ):
            stall_count += 1
        else:
            stall_count = 0
        prev_pos_err = seed_diag["final_pos_err"]

        if stall_count >= PIN_IK_STALL_ITERS:
            seed_diag["stalled"] = True
            break

    if it == max_iter - 1:
        seed_diag["iters"] = max_iter

    return pinocchio_q_to_active_q(pin_maps, q_full), seed_diag


def make_scatter_seeds(q_prev, q_ready, lower, upper, rng):
    """从 q_prev、q_ready 和噪声生成 IK 兜底用的散布种子。"""
    seeds = []
    q_prev = clip_to_bounds(q_prev, lower, upper)
    q_ready = clip_to_bounds(q_ready, lower, upper)

    seeds.append(q_prev.copy())
    seeds.append(q_ready.copy())
    bases = [q_prev, q_ready]

    for base in bases:
        for scale in NOISE_SCALES:
            for _ in range(max(1, N_NOISE_PER_BASE // len(NOISE_SCALES))):
                q_seed = base + rng.normal(scale=scale, size=len(base))
                q_seed = clip_to_bounds(q_seed, lower, upper)
                seeds.append(q_seed)

    q_mid = 0.5 * (lower + upper)
    seeds.append(clip_to_bounds(q_mid, lower, upper))

    return unique_seed_list(seeds)
