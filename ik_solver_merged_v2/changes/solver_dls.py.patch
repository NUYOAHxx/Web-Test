+def _solve_sns_clamped_step(J_active,err,z_grad,null_weight,W_inv,movable_mask,
+                           q_active_cur,eff_lower,eff_upper,damping,max_step):
+    """Compatible signature: active-face freezing + bounded/scaled SVD step.
+
+    It is not advertised as a complete SNS optimality algorithm. Actual FK and
+    endpoint limits are rechecked by the caller.
+    """
+    if damping < 0 or max_step <= 0:
+        raise ValueError("invalid damping/max_step")
+    free = np.asarray(movable_mask,dtype=bool).copy()
+    dq,ns = np.zeros(len(free)),np.zeros(len(free))
+    regularizer = damping+min(1e-3,1e-4*float(err@err))
+    for _ in range(len(free)+1):
+        if not np.any(free):
+            return np.zeros_like(dq),np.zeros_like(ns)
+        a,b = _metric_svd_step(J_active[:,free],err,
+                               None if z_grad is None else z_grad[free],
+                               W_inv[np.ix_(free,free)],regularizer)
+        dq.fill(0.)
+        ns.fill(0.)
+        ns[free] = null_weight*b
+        dq[free] = a+null_weight*b
+        blocked = free&(((q_active_cur<=eff_lower+1e-12)&(dq<0))|
+                        ((q_active_cur>=eff_upper-1e-12)&(dq>0)))
+        if not np.any(blocked):
+            break
+        free[blocked] = False
+    scale = min(1.,max_step/max(float(np.linalg.norm(dq)),1e-30))
+    for i,step in enumerate(dq):
+        if step>0 and np.isfinite(eff_upper[i]):
+            scale = min(scale,max(0.,(eff_upper[i]-q_active_cur[i])/step))
+        elif step<0 and np.isfinite(eff_lower[i]):
+            scale = min(scale,max(0.,(eff_lower[i]-q_active_cur[i])/step))
+    return scale*dq,scale*ns
