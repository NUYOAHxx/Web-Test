+def _metric_svd_step(J,error,z,D,damping,rank_rtol=1e-9):
+    """Damped primary step plus exact numerical metric-nullspace descent."""
+    J = np.asarray(J,dtype=float)
+    D = np.asarray(D,dtype=float)
+    if not np.all(np.isfinite(J)) or not np.all(np.isfinite(D)):
+        raise ValueError("non-finite Jacobian/metric")
+    if not np.allclose(D,D.T,atol=1e-12,rtol=0):
+        raise ValueError("inverse metric must be symmetric")
+    eig,V = np.linalg.eigh(D)
+    if np.any(eig<=0):
+        raise ValueError("inverse metric must be positive definite")
+    S = (V*np.sqrt(eig))@V.T
+    U,s,Vt = np.linalg.svd(J@S,full_matrices=True)
+    rank = int(np.sum(s > rank_rtol*max(1.,float(s[0]) if s.size else 1.)))
+    B = Vt.T
+    primary = np.zeros(D.shape[0])
+    if rank:
+        primary = S@B[:,:rank]@((s[:rank]/(s[:rank]**2+damping))*(U[:,:rank].T@error))
+    Z = B[:,rank:]
+    secondary = np.zeros_like(primary) if z is None else S@Z@(Z.T@(S@z))
+    return primary,secondary
